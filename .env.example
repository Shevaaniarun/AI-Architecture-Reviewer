# Copy this file to .env and adjust as needed. All values below are the
# application's built-in defaults; the app runs correctly with no .env
# file at all.

APP_ENV=development
APP_NAME=AI Architecture Reviewer
APP_VERSION=0.1.0

DATABASE_URL=sqlite:///./analysis.db

# AI review currently supports the single OpenAI Chat Completions provider.
# Keep mock as the safe default: it makes no network request and reports that
# AI is not configured, while deterministic analysis remains available.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
ENABLE_AI_ANALYSIS=true
LLM_TIMEOUT_SECONDS=30

MAX_REPOSITORY_SIZE_MB=200
MAX_FILES=5000
MAX_FILE_SIZE_MB=5

# Initial heuristic thresholds (not universal quality standards).
LONG_METHOD_LINES=50
LARGE_CLASS_METHODS=15
LONG_PARAMETER_COUNT=5
HIGH_FAN_OUT=10
HIGH_COMPLEXITY=15
WIDE_INTERFACE_METHODS=10

LOG_LEVEL=INFO
